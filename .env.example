# Copie ce fichier en .env.local (jamais commité) et remplis les valeurs depuis
# la console Firebase : Paramètres du projet → Général → "Vos applications" → app Web.
# Sans ces valeurs, l'app fonctionne normalement mais sans les sessions de groupe.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
